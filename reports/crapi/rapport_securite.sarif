          "rules": [
            {
              "id": "bola",
              "name": "bola",
              "shortDescription": {
                "text": "API1:2023 - Broken Object Level Authorization"
              },
              "fullDescription": {
                "text": "API1:2023 - Broken Object Level Authorization"
              },
              "helpUri": "https://github.com/api-sentinel/api-sentinel",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "api-security",
                  "bola"
                ]
              }
            },
            {
              "id": "rate_limiting",
              "name": "rate_limiting",
              "shortDescription": {
                "text": "API4:2023 - Unrestricted Resource Consumption"
