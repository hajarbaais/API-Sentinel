                "text": "API7:2023 - Server Side Request Forgery"
              },
              "helpUri": "https://github.com/api-sentinel/api-sentinel",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "api-security",
                  "ssrf"
                ]
              }
            }
          ]
        }
      },
